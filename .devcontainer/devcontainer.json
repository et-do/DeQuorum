{
    "name": "Dev Container",
    "build": { "dockerfile": "Dockerfile" },
    "features": {
        "ghcr.io/devcontainers-extra/features/uv:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/node:1": { "version": "22" },
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    // Named volumes so host doesn't conflict, and so caches survive rebuilds.
    // .venv lives under services/app/ now (the Python package moved into the app service).
    "mounts": [
        "source=${localWorkspaceFolderBasename}-venv,target=${containerWorkspaceFolder}/services/app/.venv,type=volume",
        "source=${localWorkspaceFolderBasename}-node-modules,target=${containerWorkspaceFolder}/services/frontend/node_modules,type=volume",
        "source=${localWorkspaceFolderBasename}-claude,target=/home/vscode/.claude,type=volume",
        "source=${localWorkspaceFolderBasename}-ollama,target=/home/vscode/.ollama,type=volume"
    ],
    "forwardPorts": [80, 5173, 8000, 9099, 11434, 4000],
    "postCreateCommand": "sudo chown -R vscode:vscode services/app/.venv services/frontend/node_modules /home/vscode/.claude /home/vscode/.ollama && cd services/app && UV_LINK_MODE=copy uv sync --extra dev && cd ../frontend && npm install --no-audit --no-fund && cd ../.. && (cd services/app && uv run pre-commit install) || true",
    "postStartCommand": "pgrep -x ollama > /dev/null || (nohup ollama serve > /tmp/ollama.log 2>&1 & disown)",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.mypy-type-checker",
                "charliermarsh.ruff",
                "qwtel.sqlite-viewer",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "tamasfe.even-better-toml",
                "ms-python.debugpy",
                "github.vscode-github-actions",
                "MichaelErmer.vsex-chromadb-viewer",
                "bierner.markdown-preview-github-styles",
                "bierner.github-markdown-preview",
                "Anthropic.claude-code"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/services/app/.venv/bin/python",
                "python.testing.cwd": "${workspaceFolder}/services/app",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true
                }
            }
        }
    }
}
