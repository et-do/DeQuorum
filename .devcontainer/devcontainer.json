{
    "name": "DeQuorum Dev Env",
    "build": { "dockerfile": "Dockerfile" },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        // moby:false -> Docker CE packages (docker.com apt repo) instead of
        // Moby. Moby's apt packages aren't published for Debian 13 "trixie"
        // (the current :debian base tag), so the default moby:true fails to
        // install. Same Apache-2.0 engine; only the package source differs.
        "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false },
        "ghcr.io/devcontainers/features/python:1": { "version": "3.13", "installTools": false }
    },
    // We deliberately don't install uv / node / etc. here — language runtimes
    // live in their service containers (services/app uses uv, services/frontend
    // uses node, etc.). Python is here only so pre-commit can run (some hooks
    // are Python packages: yamllint, validate-pyproject, pre-commit-hooks).
    "mounts": [
        "source=${localWorkspaceFolderBasename}-claude,target=/home/vscode/.claude,type=volume"
    ],
    "forwardPorts": [80, 4000, 5173, 5432, 8000, 9099, 11434],
    "portsAttributes": {
        "80":    { "label": "Caddy proxy (/ → frontend, /api → app)" },
        "4000":  { "label": "Firebase Auth emulator UI" },
        "5173":  { "label": "Vite dev server (frontend)" },
        "5432":  { "label": "Postgres" },
        "8000":  { "label": "FastAPI app (direct)" },
        "9099":  { "label": "Firebase Auth REST" },
        "11434": { "label": "Ollama" }
    },
    // Install pre-commit to the vscode user's ~/.local/bin. We can't `sudo
    // python3 ...` here because the python feature installs python3 under
    // /usr/local/python/current/bin, which is on the user PATH but NOT on
    // sudo's secure_path — `sudo python3` fails to find the binary. Running
    // unsudo'd as the vscode user works fine for a --user install, and we
    // invoke pre-commit by absolute path so it works regardless of whether
    // ~/.local/bin is on the postCreate shell PATH.
    "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.claude && python3 -m pip install --user --break-system-packages pre-commit && /home/vscode/.local/bin/pre-commit install",
    // Ensure ~/.local/bin (where pip --user puts pre-commit) is on PATH for
    // any subsequent terminal sessions the user opens inside this container.
    "remoteEnv": {
        "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "ms-azuretools.vscode-containers",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "Anthropic.claude-code",
                "ms-python.python",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "redhat.vscode-yaml",
                "bierner.markdown-preview-github-styles",
                "bierner.github-markdown-preview",
                "biomejs.biome",
                "ckolkman.vscode-postgres"
            ]
        }
    }
}
