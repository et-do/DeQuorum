# yamllint config — picked up automatically by the yamllint hook + CLI.
extends: default
rules:
  line-length:
    max: 200
    level: warning
  truthy:
    check-keys: false
  document-start: disable
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
